// Modelagem do banco de dados da Plataforma de Cursos Online (PostgreSQL)

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ==================== Usuário ====================

model Usuario {
  id           Int      @id @default(autoincrement())
  nomeCompleto String
  email        String   @unique
  senha        String // hash bcrypt, nunca a senha em texto puro
  perfil       String   @default("aluno") // administrador | instrutor | aluno
  dataCadastro DateTime @default(now()) @db.Date
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cursosMinistrados Curso[]
  matriculas        Matricula[]
  progressos        ProgressoAula[]
  avaliacoes        Avaliacao[]
  certificados      Certificado[]
  assinaturas       Assinatura[]
  notificacoes      Notificacao[]

  @@map("usuarios")
}

// ==================== Acadêmico e Conteúdo ====================

model Categoria {
  id        Int    @id @default(autoincrement())
  nome      String
  descricao String

  cursos  Curso[]
  trilhas Trilha[]

  @@map("categorias")
}

model Curso {
  id             Int      @id @default(autoincrement())
  titulo         String
  descricao      String
  idInstrutor    Int
  idCategoria    Int
  nivel          String // Iniciante | Intermediário | Avançado
  dataPublicacao DateTime @db.Date
  totalAulas     Int
  totalHoras     Int

  instrutor Usuario   @relation(fields: [idInstrutor], references: [id])
  categoria Categoria @relation(fields: [idCategoria], references: [id])

  modulos      Modulo[]
  trilhas      TrilhaCurso[]
  matriculas   Matricula[]
  avaliacoes   Avaliacao[]
  certificados Certificado[]

  @@map("cursos")
}

model Modulo {
  id      Int    @id @default(autoincrement())
  idCurso Int
  titulo  String
  ordem   Int

  curso Curso  @relation(fields: [idCurso], references: [id], onDelete: Cascade)
  aulas Aula[]

  @@map("modulos")
}

model Aula {
  id             Int    @id @default(autoincrement())
  idModulo       Int
  titulo         String
  tipoConteudo   String // Vídeo | Texto | Quiz
  urlConteudo    String
  duracaoMinutos Int
  ordem          Int

  modulo     Modulo          @relation(fields: [idModulo], references: [id], onDelete: Cascade)
  progressos ProgressoAula[]

  @@map("aulas")
}

model Trilha {
  id          Int    @id @default(autoincrement())
  titulo      String
  descricao   String
  idCategoria Int

  categoria    Categoria     @relation(fields: [idCategoria], references: [id])
  cursos       TrilhaCurso[]
  certificados Certificado[]

  @@map("trilhas")
}

// Tabela associativa N:N entre Trilha e Curso
model TrilhaCurso {
  id       Int @id @default(autoincrement())
  idTrilha Int
  idCurso  Int
  ordem    Int

  trilha Trilha @relation(fields: [idTrilha], references: [id], onDelete: Cascade)
  curso  Curso  @relation(fields: [idCurso], references: [id], onDelete: Cascade)

  @@unique([idTrilha, idCurso])
  @@map("trilhas_cursos")
}

// ==================== Progresso do Aluno ====================

model Matricula {
  id            Int       @id @default(autoincrement())
  idUsuario     Int
  idCurso       Int
  dataMatricula DateTime  @db.Date
  dataConclusao DateTime? @db.Date

  usuario Usuario @relation(fields: [idUsuario], references: [id])
  curso   Curso   @relation(fields: [idCurso], references: [id])

  @@map("matriculas")
}

model ProgressoAula {
  id            Int       @id @default(autoincrement())
  idUsuario     Int
  idAula        Int
  dataConclusao DateTime? @db.Date
  status        String // Não Iniciado | Em Progresso | Concluído

  usuario Usuario @relation(fields: [idUsuario], references: [id])
  aula    Aula    @relation(fields: [idAula], references: [id], onDelete: Cascade)

  @@map("progresso_aulas")
}

model Avaliacao {
  id            Int      @id @default(autoincrement())
  idUsuario     Int
  idCurso       Int
  nota          Int // 1 a 5
  comentario    String?
  dataAvaliacao DateTime @db.Date

  usuario Usuario @relation(fields: [idUsuario], references: [id])
  curso   Curso   @relation(fields: [idCurso], references: [id])

  @@map("avaliacoes")
}

model Certificado {
  id                Int      @id @default(autoincrement())
  idUsuario         Int
  idCurso           Int
  idTrilha          Int?
  codigoVerificacao String   @unique
  dataEmissao       DateTime @db.Date

  usuario Usuario @relation(fields: [idUsuario], references: [id])
  curso   Curso   @relation(fields: [idCurso], references: [id])
  trilha  Trilha? @relation(fields: [idTrilha], references: [id], onDelete: SetNull)

  @@map("certificados")
}

// ==================== Financeiro ====================

model Plano {
  id           Int    @id @default(autoincrement())
  nome         String
  descricao    String
  preco        Float
  duracaoMeses Int

  assinaturas Assinatura[]

  @@map("planos")
}

model Assinatura {
  id         Int      @id @default(autoincrement())
  idUsuario  Int
  idPlano    Int
  dataInicio DateTime @db.Date
  dataFim    DateTime @db.Date

  usuario    Usuario     @relation(fields: [idUsuario], references: [id])
  plano      Plano       @relation(fields: [idPlano], references: [id])
  pagamentos Pagamento[]

  @@map("assinaturas")
}

model Pagamento {
  id                 Int      @id @default(autoincrement())
  idAssinatura       Int
  valorPago          Float
  dataPagamento      DateTime @db.Date
  metodoPagamento    String // Cartão de Crédito | Boleto | Pix
  idTransacaoGateway String   @unique

  assinatura Assinatura @relation(fields: [idAssinatura], references: [id], onDelete: Cascade)

  @@map("pagamentos")
}

// ==================== Notificações (geradas pelo consumidor Kafka) ====================

model Notificacao {
  id        Int      @id @default(autoincrement())
  idUsuario Int
  titulo    String
  mensagem  String
  lida      Boolean  @default(false)
  criadaEm  DateTime @default(now())

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@map("notificacoes")
}
